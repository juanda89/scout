{
  "name": "scoutting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scouting determinista de creadoras: macro precalculado + micro bajo demanda sobre claims con evidencia",
  "scripts": {
    "scout": "tsx src/cli.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "tsx src/cli.ts db migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@typesafe-ai/sdk": "^0.7.0",
    "apify-client": "^2.25.0",
    "commander": "^15.0.0",
    "dotenv": "^17.2.0",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
