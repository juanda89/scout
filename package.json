{
  "name": "scoutting",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Scout: scouting determinista de creadoras. Monorepo: packages/core (motor), packages/db (migraciones), apps/worker, apps/web, infra.",
  "workspaces": ["packages/*", "apps/*", "infra"],
  "scripts": {
    "scout": "npm run scout -w @scout/core --",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
