# Postgres (docker compose up -d)
DATABASE_URL=postgres://scout:scout@localhost:5433/scoutting

# Proveedores. Si una clave falta, ese proveedor corre en modo mock (determinista, sin red).
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
APIFY_TOKEN=
CREATORDB_API_KEY=

# Modelos
CLAUDE_MODEL=claude-opus-5-5
JEV_MODEL=jev-latest

# Umbrales por defecto
DEFAULT_MIN_CONFIDENCE=0.85
