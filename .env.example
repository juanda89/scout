# Postgres (docker compose up -d)
DATABASE_URL=postgres://scout:scout@localhost:5433/scoutting

# LLM. Con una sola clave de OpenRouter se cubren compilación de briefs, extracción y clasificación macro.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# auto = openrouter si hay clave, si no anthropic, si no mock
LLM_PROVIDER=auto
# Modelos por rol (OpenRouter). Razonamiento: compilar briefs y extraer hechos. Clasificar: vocabulario macro.
LLM_MODEL_REASONING=google/gemini-3.8-flash
LLM_MODEL_CLASSIFY=google/gemini-3.5-flash-lite
# Alternativa aún más barata para clasificar: google/gemini-2.5-flash-lite

# Clasificador macro: auto = jev si hay TYPESAFE_API_KEY, si no llm, si no mock
CLASSIFIER=auto
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Ingesta y audiencia
APIFY_TOKEN=
CREATORDB_API_KEY=

# Umbral de confianza por defecto para que un claim automático cuente como evidencia
DEFAULT_MIN_CONFIDENCE=0.85

# SCOUT_MOCK=1 fuerza mock en todo aunque haya claves

# Web (apps/web)
AUTH_SECRET=          # openssl rand -base64 32
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=       # correos permitidos separados por coma (vacío = todos los que pasen Google)
ALLOWED_DOMAIN=       # o un dominio permitido, ej. miagencia.com
APP_URL=http://localhost:3000
SES_FROM=             # remitente verificado en SES para el email de resultados
DEV_LOGIN=0            # 1 para mantener el sign-in de desarrollo aunque haya Google
DEV_LOGIN_SECRET=      # obligatorio en producción para el sign-in de desarrollo
